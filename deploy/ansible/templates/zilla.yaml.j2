# Zilla mqtt-kafka proxy, based on aklivity/zilla examples/mqtt.kafka.proxy.
# MQTT on {{ mqtt_port.zilla }}; publishes to device/# are written to the Kafka topic mqtt-devices, keyed by MQTT topic.
# Telemetry: only the stdout log exporter (engine start/stop, client connect events, errors). No metrics.
---
name: mqtt-benchmark
stores:
  memory0:
    type: memory
bindings:
  north_tcp_server:
    type: tcp
    kind: server
    options:
      host: 0.0.0.0
      port:
        - {{ mqtt_port.zilla }}
    routes:
      - when:
          - port: {{ mqtt_port.zilla }}
        exit: north_mqtt_server
  north_mqtt_server:
    type: mqtt
    kind: server
    options:
      store: memory0
    exit: north_mqtt_kafka_mapping
  north_mqtt_kafka_mapping:
    type: mqtt-kafka
    kind: proxy
    options:
      topics:
        sessions: mqtt-sessions
        messages: mqtt-messages
        retained: mqtt-retained
    routes:
      - when:
          - publish:
              - topic: device/#
          - subscribe:
              - topic: device/#
        with:
          messages: mqtt-devices
        exit: north_kafka_cache_client
    exit: north_kafka_cache_client
  north_kafka_cache_client:
    type: kafka
    kind: cache_client
    exit: south_kafka_cache_server
  south_kafka_cache_server:
    type: kafka
    kind: cache_server
    options:
      bootstrap:
        - mqtt-messages
        - mqtt-retained
        - mqtt-devices
    exit: south_kafka_client
  south_kafka_client:
    type: kafka
    kind: client
    options:
      store: memory0
      servers:
        - ${{ '{{' }}env.KAFKA_BOOTSTRAP_SERVER{{ '}}' }}
    exit: south_tcp_client
  south_tcp_client:
    type: tcp
    kind: client
telemetry:
  exporters:
    stdout_logs_exporter:
      type: stdout
