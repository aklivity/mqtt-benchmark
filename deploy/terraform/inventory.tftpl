[broker]
broker-0 ansible_host=${broker.public_ip} private_ip=${broker.private_ip}

[kafka]
kafka-0 ansible_host=${kafka.public_ip} private_ip=${kafka.private_ip}

[clients]
%{ for i, c in clients ~}
client-${i} ansible_host=${c.public_ip} private_ip=${c.private_ip}
%{ endfor ~}

[monitor]
monitor-0 ansible_host=${monitor.public_ip} private_ip=${monitor.private_ip}

[all:vars]
ansible_user=ubuntu
