# Copy to terraform.tfvars (git-ignored) and fill in.
owner           = "your-name"
operator_cidrs  = ["203.0.113.7/32"]   # your public IP, for SSH, Grafana and Prometheus
public_key_path = "~/.ssh/mqtt-benchmark.pub"
region          = "us-east-1"

# Defaults: 32 vCPU / 64 GB for the broker and for Kafka. Override to experiment:
# broker_instance_type = "c6i.8xlarge"
# kafka_instance_type  = "c6i.8xlarge"
# client_count          = 2
# client_instance_type  = "c6i.2xlarge"
# monitor_instance_type = "t3.medium"
