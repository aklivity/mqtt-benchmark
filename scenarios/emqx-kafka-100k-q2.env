# emqx-kafka-100k at QoS 2: 100,000 publishers, 1 KB, 1 msg/s each (100,000 msg/s) into one Kafka topic, with every
# publish a full QoS 2 exchange (PUBLISH -> PUBREC -> PUBREL -> PUBCOMP). EMQ's benchmark uses QoS 1; this measures
# the same load at QoS 2. INFLIGHT stays 1 (see smoke-1k-q2.env), so a client sends at most one message per
# PUBCOMP round trip. Lower PUB_CONN_RATE (as in emqx-kafka-100k-100cps.env) if the broker can't keep up with
# 5,000 connections per second.
# shellcheck disable=SC1091
source scenarios/emqx-kafka-100k.env
NAME=emqx-kafka-100k-q2
QOS=2
