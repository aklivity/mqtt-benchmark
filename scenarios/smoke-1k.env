# Small version of emqx-kafka-100k to check a freshly provisioned environment end to end
# before paying for a full run: 1,000 connections, 1,000 msg/s, 2 minutes.

NAME=smoke-1k
MODE=pubsub
PUBLISHERS=1000
SUBSCRIBERS=0
PUB_CONN_RATE=500
PUB_TOPIC='device/%i'
QOS=1
PAYLOAD_BYTES=1024
PUBLISH_INTERVAL_MS=1000
MQTT_VERSION=4
KEEPALIVE_S=300
CLEAN_SESSION=true
INFLIGHT=1

KAFKA_TOPIC=mqtt-devices
KAFKA_PARTITIONS=16
KAFKA_REPLICATION=1

WARMUP_S=15
DURATION_S=120

PROBE_CONNECTIONS=10
