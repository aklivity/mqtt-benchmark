# Open MQTT Benchmark Suite, Basic Set: singlenode-p2p-1K-1K-1K-1K
# https://github.com/emqx/mqttbs
# 1,000 publishers and 1,000 subscribers in pairs: publisher N and subscriber N share topic device/N.
# Each publisher sends 1 msg/s (1,000 msg/s in and out). QoS 1, retain 0, 16-byte payload, 30 minutes.
# Pairs run on the same client host (PLACEMENT=split), so end-to-end latency uses one clock.

NAME=basic-p2p-1k-ps-240
MODE=pubsub
SUBSCRIBERS=1000
SUB_CONN_RATE=500           # not specified by the suite
SUB_TOPIC='device/%i'
SUB_QOS=1
PUBLISHERS=1000
PUB_CONN_RATE=500
PUB_TOPIC='device/%i'
PLACEMENT=split
DELIVERIES_PER_MSG=1
QOS=1
PAYLOAD_BYTES=16
PUBLISH_INTERVAL_MS=1000
INFLIGHT=1
MQTT_VERSION=5              # MQTT 3.1.1
KEEPALIVE_S=300
CLEAN_SESSION=false

KAFKA_TOPIC=mqtt-devices

WARMUP_S=30
DURATION_S=240

PROBE_CONNECTIONS=10
SESSION_EXPIRY_S=3600
