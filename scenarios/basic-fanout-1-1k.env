# Open MQTT Benchmark Suite, Basic Set: singlenode-fanout-1-1K-1-1K
# https://github.com/emqx/mqttbs
# 1 publisher, 1,000 subscribers on 1 topic. The publisher sends 1 msg/s; every subscriber receives it
# (1,000 msg/s delivered). QoS 1, retain 0, 16-byte payload, 30 minutes.
# Through Zilla, each message goes to Kafka and is read back from Kafka for the subscribers.

NAME=basic-fanout-1-1k
MODE=pubsub
SUBSCRIBERS=1000
SUB_CONN_RATE=500           # not specified by the suite
SUB_TOPIC='device/fanout'
SUB_QOS=1
PUBLISHERS=1
PUB_CONN_RATE=1
PUB_TOPIC='device/fanout'
PLACEMENT=first             # the single publisher runs on client host 0
DELIVERIES_PER_MSG=1000     # every subscriber gets every message
QOS=1
PAYLOAD_BYTES=16
PUBLISH_INTERVAL_MS=1000
INFLIGHT=1
MQTT_VERSION=4              # MQTT 3.1.1
KEEPALIVE_S=300
CLEAN_SESSION=true

KAFKA_TOPIC=mqtt-devices

WARMUP_S=30
DURATION_S=1800

PROBE_CONNECTIONS=10        # publish response time on separate topics (not received by the subscribers)
