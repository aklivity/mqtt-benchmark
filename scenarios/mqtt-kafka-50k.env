# mqtt-kafka-100k with 50,000 publishers: 50,000 connections at 5,000/s, one topic each, QoS 1, 1 KB, every client
# publishes once per second (50,000 msg/s in total) into the same Kafka topic. Everything else is the same as
# mqtt-kafka-100k.
# shellcheck disable=SC1091
source scenarios/mqtt-kafka-100k.env
NAME=mqtt-kafka-50k
PUBLISHERS=50000
