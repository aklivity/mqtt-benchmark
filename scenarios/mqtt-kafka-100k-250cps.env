# mqtt-kafka-100k with a lower connection rate: 250 new connections per second instead of 5,000 (100,000 clients
# connect in about 7 minutes). Everything else is the same as mqtt-kafka-100k.
# Use it to measure the 100K-connection, 100K msg/s steady state without the 5,000/s connection ramp, and state
# the rate with the results.
# shellcheck disable=SC1091
source scenarios/mqtt-kafka-100k.env
NAME=mqtt-kafka-100k-250cps
PUB_CONN_RATE=250
