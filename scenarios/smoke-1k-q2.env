# smoke-1k at QoS 2: 1,000 publishers, 1,000 msg/s, 2 minutes. Check a new environment's QoS 2 path with this and
# `QOS=2 bin/verify-delivery.sh` before a full-size QoS 2 run.
# INFLIGHT stays 1: every client completes PUBLISH -> PUBREC -> PUBREL -> PUBCOMP before its next PUBLISH.
# shellcheck disable=SC1091
source scenarios/smoke-1k.env
NAME=smoke-1k-q2
QOS=2
