# Open MQTT Benchmark Suite, Basic Set: singlenode-conn-tcp-10K-100
# https://github.com/emqx/mqttbs
# 10,000 clients connect within 100 s (100/s) and stay connected for 30 minutes. No messages.
# Reported: connections, success rate, connect rate achieved, connect latency, Zilla host CPU and memory.

NAME=basic-conn-10k
MODE=conn
CONNECTIONS=10000
CONN_RATE=100
MQTT_VERSION=4              # MQTT 3.1.1
KEEPALIVE_S=300
CLEAN_SESSION=true

WARMUP_S=0
DURATION_S=1800             # hold time
