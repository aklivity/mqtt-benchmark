# MQTT to Kafka on a single broker node.
# 100,000 connections at 5,000/s, 100,000 topics, QoS 1, 1 KB payload, every client publishes once per second
# (100,000 msg/s in total), all of it written to one Kafka topic with 16 partitions and replication factor 1.

NAME=mqtt-kafka-100k
MODE=pubsub
PUBLISHERS=100000           # spread evenly over the client hosts
SUBSCRIBERS=0               # publish only: every message goes into Kafka, none back out over MQTT
PUB_CONN_RATE=5000          # new connections per second, in total
PUB_TOPIC='device/%i'           # one topic per client (%i is the client's sequence number)
QOS=1
PAYLOAD_BYTES=1024
PUBLISH_INTERVAL_MS=1000    # per client: 1 msg/s -> PUBLISHERS msg/s in total
MQTT_VERSION=4              # emqtt-bench: 3 = MQTT 3.1, 4 = MQTT 3.1.1, 5 = MQTT 5
KEEPALIVE_S=300
CLEAN_SESSION=true
INFLIGHT=1                  # unacknowledged QoS 1 messages per client

KAFKA_TOPIC=mqtt-devices
KAFKA_PARTITIONS=16
KAFKA_REPLICATION=1

# Timing: a 30-minute window, as in the Open MQTT Benchmark Suite.
WARMUP_S=60                 # after all clients have connected, before measuring
DURATION_S=1800             # measurement window

# Publish response time is measured by bin/puback-probe.py on a sample of extra connections
PROBE_CONNECTIONS=100
