# emqx-kafka-100k with a lower connection rate: 100 new connections per second instead of 5,000 (100,000 clients
# connect in about 17 minutes). Everything else is the same as emqx-kafka-100k.
# Use it when the target can't complete 5,000 CONNECT/CONNACK handshakes per second, and state the rate with the
# results: it measures the 100K-connection, 100K msg/s steady state, not EMQ's connection ramp.
# shellcheck disable=SC1091
source scenarios/emqx-kafka-100k.env
NAME=emqx-kafka-100k-100cps
PUB_CONN_RATE=100
