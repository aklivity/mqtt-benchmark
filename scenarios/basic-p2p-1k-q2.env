# basic-p2p-1k at QoS 2: 1,000 publisher/subscriber pairs, QoS 2 publishes and QoS 2 subscriptions, 1,000 msg/s in
# and out, 16-byte payload, 30 minutes. The Open MQTT Benchmark Suite's Basic Set uses QoS 1; this is the same load at
# QoS 2. INFLIGHT stays 1 (see smoke-1k-q2.env).
# shellcheck disable=SC1091
source scenarios/basic-p2p-1k.env
NAME=basic-p2p-1k-q2
QOS=2
SUB_QOS=2
