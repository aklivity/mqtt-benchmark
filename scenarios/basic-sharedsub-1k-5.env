# Open MQTT Benchmark Suite, Basic Set: singlenode-sharedsub-1K-5-1K-1K
# https://github.com/emqx/mqttbs
# 1,000 publishers on 1,000 topics, 5 subscribers in one shared subscription group. Each publisher sends 1 msg/s;
# each message goes to one member of the group (1,000 msg/s in and out). MQTT 5, QoS 1, retain 0, 16 bytes, 30 min.
#
# The suite uses topics test/1..test/1000 and the filter $share/benchmark/test/#. Zilla's benchmark config routes
# device/#, so this uses device/N and $share/benchmark/device/# instead.

NAME=basic-sharedsub-1k-5
MODE=pubsub
SUBSCRIBERS=5
SUB_CONN_RATE=5
SUB_TOPIC='$share/benchmark/device/#'
SUB_QOS=1
PUBLISHERS=1000
PUB_CONN_RATE=500           # not specified by the suite
PUB_TOPIC='device/%i'
PLACEMENT=split
DELIVERIES_PER_MSG=1        # one group member receives each message
QOS=1
PAYLOAD_BYTES=16
PUBLISH_INTERVAL_MS=1000
INFLIGHT=1
MQTT_VERSION=5              # shared subscriptions need MQTT 5
KEEPALIVE_S=300
CLEAN_SESSION=true

KAFKA_TOPIC=mqtt-devices

WARMUP_S=30
DURATION_S=1800

PROBE_CONNECTIONS=0         # probe topics would match the shared filter and skew the delivery count
